#usda 1.0
(
    defaultPrim = "Root"
    metersPerUnit = 1
    upAxis = "Y"
)
def Xform "Root"
{
    def Mesh "RightHanded"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(-2, 0, 0), (-1, 0, 0), (-1.5, 1, 0)]
        color3f[] primvars:displayColor = [(1, 0, 0)]
        uniform token subdivisionScheme = "none"
    }
    def Mesh "LeftHanded"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(1, 0, 0), (2, 0, 0), (1.5, 1, 0)]
        color3f[] primvars:displayColor = [(0, 0, 1)]
        uniform token orientation = "leftHanded"
        uniform token subdivisionScheme = "none"
    }
    def Mesh "RightHandedCW"
    {
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 2, 1]
        point3f[] points = [(-0.5, 0, 0), (0.5, 0, 0), (0, 1, 0)]
        color3f[] primvars:displayColor = [(0, 1, 0)]
        uniform token subdivisionScheme = "none"
    }
}
def Camera "Cam"
{
    float focalLength = 20
    double3 xformOp:translate = (0, 0.5, 8)
    uniform token[] xformOpOrder = ["xformOp:translate"]
}
