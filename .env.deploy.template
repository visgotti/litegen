# LiteGen deploy config. Copy to `.env.deploy` (gitignored) and fill in.
#   cp .env.deploy.template .env.deploy
# deploy.js reads this file; values already in the real environment win.

# ── DigitalOcean (proxy + db droplet) ──
DO_API_KEY=<your-digitalocean-api-token>
DO_SSH_KEY_PATH=~/.ssh/id_ed25519
# Droplet shape — defaults are fine. ~$12/mo at s-1vcpu-2gb.
DO_REGION=nyc3
DO_SIZE=s-1vcpu-2gb
DO_IMAGE=ubuntu-24-04-x64
# Filled in automatically by `node deploy.js provision`. Leave blank.
DO_DROPLET_IP=

# ── GHCR (GitHub Container Registry — proxy image) ──
GHCR_USER=visgotti
GHCR_TOKEN=<github-pat-with-write:packages>

# Proxy build location:
#   ghcr      → build the image locally, push to GHCR, droplet pulls it.
#               Requires clean TLS egress to Docker Hub + crates.io.
#   ondroplet → build natively on the droplet (clean network, native amd64).
#               Use this behind a TLS-intercepting corporate proxy, or to
#               skip slow QEMU cross-builds. (GHCR_TOKEN not needed.)
PROXY_BUILD=ghcr

# ── Cloudflare (landing site → Pages) ──
CLOUDFLARE_API_TOKEN=<cloudflare-api-token>
CLOUDFLARE_ACCOUNT_ID=<cloudflare-account-id>
CF_PAGES_PROJECT=litegen-landing

# ── LiteGen proxy secrets (auto-generated + persisted on first run) ──
# Leave blank; deploy.js generates and writes them back here.
# NOTE: in single-tenant mode on a public bind, the proxy refuses to start
# without a real (non-blank) master key. The hosted deploy sets LITEGEN__MODE=hosted
# (see .env.deploy), where the no-auth bypass is disabled, but the master key is
# still used as the platform-admin bearer token, so keep it populated.
LITEGEN__MASTER_KEY=
POSTGRES_PASSWORD=

# ── Public origin of the proxy ──
# Where clients reach it, e.g. https://app.litegen.ai/api (the Caddy /api route).
# Locally stored 3D asset URLs are minted from it; left blank they point at
# http://127.0.0.1:4000, which no remote client can open.
LITEGEN__SERVER__PUBLIC_BASE_URL=

# ── Optional: Redis, to run several replicas (docs/scaling.md) ──
# With neither a URL nor a host, litegen runs as a single replica.
# The whole URL (percent-encode the password in it) ...
# LITEGEN_REDIS_URL=rediss://default:<password>@<host>:<port>
# ... or the parts (a password with @ or : needs no encoding here).
# LITEGEN_REDIS_HOST=<host>
# LITEGEN_REDIS_PORT=6379
# LITEGEN_REDIS_USERNAME=default
# LITEGEN_REDIS_PASSWORD=<password>
# LITEGEN_REDIS_SSL=true

# ── Optional: the database as parts, instead of LITEGEN_DATABASE_URL ──
# Spelled LITEGEN_DATABASE_* or LITEGEN_DB_*. The URL wins when both are set.
# LITEGEN_DB_HOST=<host>
# LITEGEN_DB_PORT=5432
# LITEGEN_DB_USER=<user>
# LITEGEN_DB_PASSWORD=<password>
# LITEGEN_DB_NAME=<database>
# LITEGEN_DB_SSLMODE=require

# ── Optional: provider keys baked into the hosted proxy ──
# OPENAI_API_KEY=
# REPLICATE_API_TOKEN=
# GOOGLE_API_KEY=
# FAL_KEY=
