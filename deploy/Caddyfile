www.litegen.ai {
    redir https://litegen.ai{uri} permanent
}

litegen.ai {
    root * /srv/landing
    encode gzip
    # Next.js static export with next-intl: pages are emitted as <path>.html and
    # the home route lives at /en.html (the CF-Pages _redirects file that maps
    # `/` → `/en` is ignored by Caddy), so fall back to the default locale.
    try_files {path} {path}.html {path}/index.html /en.html
    file_server
}

app.litegen.ai {
    # MCP OAuth discovery at the root, where clients derive it from the
    # endpoint URL (RFC 9728 / RFC 8414): /.well-known/oauth-protected-resource/api/mcp
    # and /.well-known/oauth-authorization-server/api. Not stripped.
    handle /.well-known/oauth-* {
        reverse_proxy litegen:4000
    }
    handle_path /api/* {
        reverse_proxy litegen:4000
    }
    handle {
        # The MCP OAuth consent page grants apps access: no other site may frame it.
        @consent path /oauth/consent
        header @consent Content-Security-Policy "frame-ancestors 'none'"
        header @consent X-Frame-Options "DENY"
        root * /srv/app
        try_files {path} /index.html
        file_server
        encode gzip
    }
}
