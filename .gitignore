# Claude Code (personal, machine-local overrides + worktrees — never publish)
.claude/

# Rust
litegen-core/target/

# Node / Dashboard
node_modules/
dashboard/node_modules/
dashboard/dist/
dashboard/dist-ssr/
*.local

# Cloudflare Wrangler / Next build output
.wrangler/
.next/
out/

# Playwright
dashboard/test-results/
dashboard/playwright-report/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment
.env
.env.*
!.env.example
# Deploy: commit the placeholder template, never the real secrets file.
!.env.deploy.template

# Local runtime config + db (litegen.yaml is generated from aipix's .env by
# aipix/scripts/litegen.mjs and contains real provider API keys — never commit).
litegen.yaml
litegen.db
litegen-dev.db
*.db-shm
*.db-wal
.credentials
# Ad-hoc verification / browser-automation artifacts (screenshots, MCP session
# snapshots). Save these under .artifacts/ (below) during manual verification,
# never loose at repo root — a loose PNG here is almost always a leftover
# screenshot, not a real asset (those live under public/ or src/assets/).
/*.png
/*.jpg
/*.jpeg
.playwright-mcp/

# Scratch/verification artifacts — screenshots, one-off dumps, anything from a
# manual check that isn't a build output or a real repo asset.
.artifacts/
